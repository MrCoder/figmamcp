{
  "name": "figmamcp",
  "version": "0.1.25",
  "mcpName": "io.github.MrCoder/figmamcp",
  "description": "Read, create, and modify Figma designs programmatically via MCP, empowering AI to execute Figma changes safer, cleaner, and faster.",
  "keywords": [
    "mcp",
    "mcp-server",
    "figma",
    "figma-plugin",
    "model-context-protocol",
    "design-automation",
    "ai",
    "claude",
    "cursor"
  ],
  "homepage": "https://figmamcp.dev/",
  "bugs": {
    "url": "https://github.com/MrCoder/figmamcp-releases/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrCoder/figmamcp-releases.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "MrCoder",
    "url": "https://github.com/MrCoder"
  },
  "type": "module",
  "engines": {
    "node": ">=20",
    "bun": ">=1.3.0"
  },
  "bin": {
    "figmamcp": "dist/figmamcp.js",
    "figmamcp-relay": "dist/socket.js"
  },
  "files": [
    "dist/figmamcp.js",
    "dist/server.js",
    "dist/socket.js",
    "figma_plugin/manifest.json",
    "figma_plugin/code.js",
    "figma_plugin/ui.html",
    "skills",
    "README.md",
    "LICENSE",
    "icon.png"
  ],
  "scripts": {
    "test": "bun test src/mcp_server/tests",
    "test:live": "bun run scripts/live-verify.ts",
    "test:live:phase14": "bun run scripts/phase14-live-verify.ts",
    "start": "bun run dist/server.js",
    "socket": "bun run src/socket.ts",
    "setup": "./scripts/setup.sh",
    "integrate": "./scripts/integrate.sh",
    "build": "tsup",
    "build:watch": "tsup --watch",
    "dev": "bun run build:watch",
    "plugin:build": "node figma_plugin/build.js",
    "plugin:watch": "node figma_plugin/build.js --watch",
    "build:all": "bun run gen:node-fields && bun run build && bun run plugin:build",
    "build:binaries": "bash scripts/build-binaries.sh",
    "check:plugin": "bun run scripts/check-plugin-build.ts",
    "check:generated": "bun run scripts/check-generated.ts",
    "check:versions": "bun run scripts/check-versions.ts",
    "deploy:site": "bunx wrangler@4.165.0 deploy && bun run scripts/indexnow-ping.ts",
    "site:dates": "bun run scripts/stamp-site-dates.ts",
    "check:types:plugin": "tsc --noEmit -p figma_plugin/tsconfig.json",
    "check:types:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "check:suppressions": "bun run scripts/check-suppressions.ts",
    "gen:node-fields": "bun run scripts/gen-node-fields.ts",
    "gen:manifest": "bun run scripts/gen-manifest-tools.ts",
    "build:smithery": "bash scripts/build-smithery-bundle.sh",
    "prepublishOnly": "bun run build:all"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "jimp": "^0.22.12",
    "uuid": "14.0.0",
    "ws": "8.20.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@figma/plugin-typings": "1.125.0",
    "@types/bun": "1.3.13",
    "esbuild": "0.28.0",
    "tsup": "8.5.1",
    "typescript": "6.0.3"
  }
}
